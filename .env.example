MYSQL_HOST=localhost
MYSQL_PORT=3306
# Leave blank for local MySQL. On Render, add the provider's CA certificate as
# a Secret File named ca.pem and set MYSQL_SSL_CA=/etc/secrets/ca.pem.
MYSQL_SSL_CA=
MYSQL_USER=root
# Enter your own local MySQL password; never commit the real .env file.
MYSQL_PASSWORD=
MYSQL_DB=gottime
MYSQL_TIME_ZONE=+05:30
# Set a long private random value before running serve.py.
SECRET_KEY=dev-secret-key
WEB_THREADS=8
HOST=127.0.0.1
PORT=5000
FRONTEND_URL=http://localhost:5173

# Google OAuth
# Create these in Google Cloud Console and add this redirect URI:
# http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
GOOGLE_OAUTH_VERIFY_SSL=true

# Razorpay payments
# Use test keys while developing. Checkout supports cards, UPI apps, wallets, and netbanking.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate random secret shared with the Razorpay webhook (not your API key secret).
RAZORPAY_WEBHOOK_SECRET=

# Optional direct UPI QR for public donations
DONATION_UPI_ID=
DONATION_UPI_NAME=GotTime
